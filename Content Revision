    /* ==============================
       파일 저장 (Claude 아티팩트 downloads 권한 우선,
       미지원 환경에서는 표준 다운로드로 대체)
       ============================== */
    async function saveFile(filename, dataBlob) {
      try {
        if (window.claude && typeof window.claude.use === "function") {
          const downloads = await window.claude.use("downloads");
          if (downloads) {
            await downloads.save({ filename, data: dataBlob });
            return true;
          }
        }
      } catch (err) {
        if (err && err.code === "declined") return false;
        // 그 외 오류는 아래 대체 방식으로 넘어갑니다.
      }
      try {
        const url = URL.createObjectURL(dataBlob);
        const a = document.createElement("a");
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        return true;
      } catch (err2) {
        return false;
      }
    }

    async function downloadCSV() {
      const stats = getStats();
      const rows = [
        ["구분", "항목", "인원"],
        ["전체", "전체 참여자", stats.total],
        ["유형", "문제발견형", stats.types.problem || 0],
        ["유형", "아이디어기획형", stats.types.idea || 0],
        ["유형", "실행성장형", stats.types.execute || 0],
        ["유형", "연결확산형", stats.types.connect || 0]
      ];

      Object.keys(stats.dates).sort().forEach(date => {
        rows.push(["일자", date, stats.dates[date]]);
      });

      const csv = "\uFEFF" + rows.map(row => row.map(csvEscape).join(",")).join("\r\n");
      const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
      const ok = await saveFile(`임팩트유형테스트_익명통계_${localDateString()}.csv`, blob);
      if (!ok) alert("CSV 파일을 저장하지 못했어요. 다시 시도해 주세요.");
    }

