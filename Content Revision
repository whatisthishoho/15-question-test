        status.textContent = "전송 기능이 아직 연결되지 않았어요.";
        status.className = "email-status err";
        return;
      }

      const t = TYPES[currentResult];
      btn.disabled = true;
      btn.textContent = "전송 중...";
      status.textContent = "";
      status.className = "email-status";

      try {
        const res = await fetch(CONFIG.emailEndpoint, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify({
