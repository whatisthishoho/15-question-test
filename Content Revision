      if (!name || !isValidEmail(email) || !currentResult) return;

      if (!CONFIG.emailEndpoint) {
        status.textContent = "결과 전송 기능이 아직 연결되지 않았어요. 관리자에게 문의해 주세요.";
        status.className = "email-status err";
        return;
      }

      const t = TYPES[currentResult];
      sendBtn.disabled = true;
      sendBtn.textContent = "이미지 만드는 중...";
      status.textContent = "";
      status.className = "email-status";

      let imageDebugNote = "";
      try {
        let imageBase64 = "";
        try {
          imageBase64 = await getResultImageBase64(t, name);
          if (!imageBase64) imageDebugNote = " [디버그: 이미지 데이터 비어있음]";
        } catch (imgErr) {
          imageBase64 = ""; // 이미지 생성 실패해도 이메일 발송은 계속 진행
          imageDebugNote = " [디버그: 이미지 생성 오류 - " + (imgErr && imgErr.message ? imgErr.message : String(imgErr)) + "]";
        }

        sendBtn.textContent = "전송 중...";

        const res = await fetch(CONFIG.emailEndpoint, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify({
            name,
            phone,
            email,
            newsletter,
            resultKey: currentResult,
            resultName: t.name,
            resultDesc: t.desc,
            resultAction: t.action,
            consent: true,
            submittedAt: new Date().toISOString(),
            imageBase64
          })
        });
        const data = await res.json().catch(() => null);
        if (res.ok && data && data.status === "ok") {
          status.textContent = "결과를 이메일로 보내드렸어요. 잠시 후 도착합니다." + imageDebugNote;
          status.className = "email-status " + (imageDebugNote ? "err" : "ok");
          sendBtn.textContent = "전송 완료";
        } else {
          const serverMsg = data && data.message ? (" [서버: " + data.message + "]") : "";
          throw new Error("bad_response" + serverMsg);
        }
      } catch (err) {
        status.textContent = "전송에 실패했어요. 잠시 후 다시 시도해 주세요. [디버그: " + (err && err.message ? err.message : String(err)) + "]";
