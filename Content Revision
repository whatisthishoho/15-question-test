<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1"><style>:root{color-scheme:light}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#faf9f5;color:#141413}img{max-width:100%}[hidden]:not([hidden=until-found]){display:none!important}</style></head><body>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#143D5B" />
  <title>15문항 임팩트 유형 테스트 · 함께일하는재단</title>
  <style>
    :root {
      --navy: #143D5B;
      --navy-2: #0C2D43;
      --green: #26A269;
      --green-light: #EAF7F0;
      --blue-light: #EAF3F8;
      --yellow: #FFD166;
      --coral: #FF7A66;
      --ink: #18313F;
      --muted: #627985;
      --line: #D8E3E8;
      --paper: #FFFFFF;
      --bg: #FDFDF0;
      --lemon: #F5EFA8;
      --lemon-ink: #6B5B12;
      --lemon-line: #EDE7A8;
      --gold: #E8C547;
      --gold-ink: #A67C00;
      --gold-light: #FCF3D0;
      --card-lemon: #FFFFFF;
      --shadow: 0 18px 45px rgba(20, 61, 91, 0.14);
      --radius: 24px;
    }

    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans KR",
                   "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at top left, rgba(232,197,71,.16), transparent 34%),
        radial-gradient(circle at bottom right, rgba(20,61,91,.11), transparent 32%),
        var(--bg);
      -webkit-tap-highlight-color: transparent;
      overscroll-behavior: none;
    }

    button, a { font: inherit; }
    button {
      border: 0;
      cursor: pointer;
      touch-action: manipulation;
      -webkit-touch-callout: none;
      -webkit-tap-highlight-color: transparent;
      -webkit-user-select: none;
      user-select: none;
    }
    a { touch-action: manipulation; }
    .answer-btn, .tie-btn, .primary-btn, .secondary-btn, .icon-btn,
    .text-btn, .danger-btn, .modal-close {
      position: relative;
      z-index: 1;
    }
    button:focus-visible, a:focus-visible {
      outline: 4px solid rgba(255, 209, 102, .9);
      outline-offset: 3px;
    }

    .app-shell {
      min-height: 100%;
      display: flex;
      flex-direction: column;
      padding: max(16px, env(safe-area-inset-top))
               max(16px, env(safe-area-inset-right))
               max(16px, env(safe-area-inset-bottom))
               max(16px, env(safe-area-inset-left));
    }

    .topbar {
      width: min(920px, 100%);
      margin: 0 auto 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-height: 40px;
    }

    .brand {
      display: flex;
      align-items: center;
      min-width: 0;
    }

    .brand-logo {
      display: block;
      width: clamp(190px, 28vw, 270px);
      max-width: 100%;
      height: auto;
      object-fit: contain;
      user-select: none;
      -webkit-user-drag: none;
    }

    .top-actions { display: flex; gap: 8px; }

    .icon-btn {
      min-width: 42px;
      min-height: 42px;
      border-radius: 14px;
      background: rgba(255,255,255,.86);
      color: var(--navy);
      border: 1px solid rgba(20,61,91,.12);
      display: grid;
      place-items: center;
      box-shadow: 0 6px 18px rgba(20,61,91,.07);
    }

    main {
      width: min(920px, 100%);
      margin: auto;
      display: grid;
      place-items: center;
      flex: 1;
    }

    .screen {
      display: none;
      width: 100%;
      animation: fadeUp .28s ease both;
    }
    .screen.active { display: block; }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes startPop {
      0% { opacity: 0; transform: scale(.55) translateY(14px); }
      60% { opacity: 1; transform: scale(1.14) translateY(-4px); }
      80% { transform: scale(.96) translateY(1px); }
      100% { opacity: 1; transform: scale(1) translateY(0); }
    }
    #start-screen.active .start-preview-icon {
      opacity: 0;
      animation: startPop .6s cubic-bezier(.34, 1.56, .64, 1) both;
    }
    #start-screen.active .start-preview-icon:nth-child(1) { animation-delay: .05s; }
    #start-screen.active .start-preview-icon:nth-child(2) { animation-delay: .16s; }
    #start-screen.active .start-preview-icon:nth-child(3) { animation-delay: .27s; }
    #start-screen.active .start-preview-icon:nth-child(4) { animation-delay: .38s; }

    .mid-cheer {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      z-index: 60;
      background: rgba(50, 45, 10, 0);
      transition: opacity .25s ease, background .25s ease;
    }
    .mid-cheer.show {
      opacity: 1;
      pointer-events: auto;
      background: rgba(50, 45, 10, .16);
    }
    .mid-cheer-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      background: #fff;
      border: 3px solid var(--lemon-line, #EDE7A8);
      border-radius: 32px;
      padding: 30px 32px 26px;
      max-width: min(84vw, 340px);
      box-shadow: 0 26px 60px -12px rgba(20, 30, 60, .38);
      text-align: center;
      transform: scale(.4) rotate(-6deg);
      opacity: 0;
    }
    .mid-cheer.show .mid-cheer-inner {
      animation: cheerPop .68s cubic-bezier(.34, 1.56, .64, 1) both;
    }
    @keyframes cheerPop {
      0% { transform: scale(.4) rotate(-6deg); opacity: 0; }
      55% { transform: scale(1.14) rotate(3deg); opacity: 1; }
      75% { transform: scale(.95) rotate(-1.5deg); }
      100% { transform: scale(1) rotate(0); opacity: 1; }
    }
    .mid-cheer-sparkle {
      font-size: 26px;
      margin-bottom: -6px;
      animation: sparkleSpin 1.6s ease-in-out infinite;
    }
    @keyframes sparkleSpin {
      0%, 100% { transform: rotate(-8deg) scale(1); }
      50% { transform: rotate(8deg) scale(1.15); }
    }
    .mid-cheer-icon {
      width: 116px;
      height: 116px;
      border-radius: 50%;
      object-fit: cover;
      box-shadow: 0 10px 24px -6px rgba(20, 30, 60, .3), inset 0 0 0 5px #f6f4e2;
    }
    .mid-cheer-text {
      font-size: 19px;
      font-weight: 900;
      color: var(--navy-2, #33415c);
      word-break: keep-all;
      line-height: 1.45;
    }
    @media (max-width: 480px) {
      .mid-cheer-icon { width: 92px; height: 92px; }
      .mid-cheer-text { font-size: 16px; }
    }

    .card {
      background: rgba(255,255,255,.96);
      border: 1px solid rgba(20,61,91,.09);
      box-shadow: var(--shadow);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .start-card,
    .question-card,
    .tie-card {
      background: var(--card-lemon, #FFF9E3);
      border-color: rgba(138, 106, 31, 0.14);
    }

    .start-card {
      padding: clamp(30px, 6vw, 72px);
      text-align: center;
      position: relative;
      isolation: isolate;
    }

    .start-card::before {
      content: "";
      position: absolute;
      inset: -120px auto auto -120px;
      width: 270px;
      height: 270px;
      border-radius: 50%;
      background: rgba(250,250,210,.5);
      z-index: -1;
    }

    .start-card::after {
      content: "";
      position: absolute;
      right: -90px;
      bottom: -100px;
      width: 250px;
      height: 250px;
      border-radius: 55px;
      transform: rotate(22deg);
      background: rgba(250,250,210,.32);
      z-index: -1;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 13px;
      border-radius: 999px;
      color: var(--navy);
      background: var(--blue-light);
      font-size: clamp(13px, 2vw, 16px);
      font-weight: 800;
      margin-bottom: 22px;
    }
    .start-eyebrow-lemon {
      color: var(--lemon-ink, #8A6A1F);
      background: var(--lemon, #FCEFC7);
      font-size: clamp(10px, 1.6vw, 13px);
      padding: 6px 11px;
      margin-bottom: 10px;
    }

    h1, h2, h3, p { margin-top: 0; }
    h1 {
      font-size: clamp(34px, 6vw, 64px);
      line-height: 1.08;
      letter-spacing: -0.055em;
      margin-bottom: 18px;
      color: var(--navy-2);
    }

    .accent { color: var(--gold-ink, #A67C00); }

    .lead {
      max-width: 680px;
      margin: 0 auto 28px;
      font-size: clamp(17px, 2.4vw, 23px);
      line-height: 1.65;
      color: var(--muted);
      word-break: keep-all;
    }
    .start-lead-small {
      font-size: clamp(10px, 1.44vw, 14px);
      margin-bottom: 18px;
    }

    .primary-btn {
      min-height: 64px;
      padding: 0 28px;
      border-radius: 18px;
      background: linear-gradient(135deg, #E0A100, #FFC94D);
      color: white;
      font-size: clamp(18px, 2.5vw, 22px);
      font-weight: 900;
      box-shadow: 0 14px 28px rgba(224,161,0,.32);
      transition: transform .14s ease, box-shadow .14s ease;
    }
    .primary-btn:hover { transform: translateY(-2px); box-shadow: 0 18px 34px rgba(224,161,0,.36); }
    .primary-btn:active { transform: translateY(0); }

    .disclaimer {
      margin: 24px auto 0;
      max-width: 660px;
      color: #718691;
      font-size: 13px;
      line-height: 1.55;
    }

    .question-card { padding: clamp(24px, 4vw, 44px); }

    .progress-wrap {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 30px;
    }

    .progress-track {
      flex: 1;
      height: 12px;
      background: #E8EFF2;
      border-radius: 999px;
      overflow: hidden;
    }

    .progress-bar {
      height: 100%;
      width: 0;
      background: linear-gradient(90deg, var(--gold, #E8C547), #F4DA7E);
      border-radius: inherit;
      transition: width .26s ease;
    }

    .progress-label {
      min-width: 64px;
      text-align: right;
      color: var(--navy);
      font-weight: 900;
    }

    .question-number {
      color: var(--gold-ink, #A67C00);
      font-weight: 900;
      letter-spacing: .02em;
      margin-bottom: 10px;
      font-size: 16px;
    }

    .question-title {
      font-size: clamp(27px, 4vw, 42px);
      line-height: 1.3;
      letter-spacing: -0.04em;
      color: var(--navy-2);
      margin-bottom: 28px;
      word-break: keep-all;
      white-space: pre-line;
    }

    .answers {
      display: grid;
      gap: 14px;
    }

    .answer-btn {
      width: 100%;
      min-height: 94px;
      padding: 22px 24px;
      border-radius: 20px;
      border: 2px solid var(--line);
      background: white;
      text-align: left;
      color: var(--ink);
      display: flex;
      align-items: center;
      gap: 18px;
      transition: border-color .14s ease, background .14s ease, transform .14s ease;
    }

    @media (hover: hover) and (pointer: fine) {
      .answer-btn:hover {
        border-color: var(--gold, #E8C547);
        background: var(--gold-light, #FCF3D0);
        transform: translateY(-2px);
      }
    }
    .answer-btn:active {
      border-color: var(--gold, #E8C547);
      background: var(--gold-light, #FCF3D0);
    }

    .answer-badge {
      flex: 0 0 44px;
      width: 44px;
      height: 44px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      background: var(--blue-light);
      color: var(--navy);
      font-weight: 1000;
      font-size: 20px;
    }

    .answer-text {
      font-size: clamp(17px, 2.4vw, 22px);
      font-weight: 800;
      line-height: 1.45;
      word-break: keep-all;
    }

    .back-row {
      margin-top: 18px;
      display: flex;
      justify-content: flex-start;
    }

    .text-btn {
      background: transparent;
      color: var(--muted);
      font-weight: 800;
      padding: 10px 6px;
    }

    .tie-card {
      padding: clamp(26px, 5vw, 54px);
      text-align: center;
    }

    .tie-options {
      margin-top: 26px;
      display: grid;
      gap: 12px;
    }

    .tie-btn {
      padding: 18px 20px;
      border-radius: 18px;
      background: white;
      border: 2px solid var(--line);
      color: var(--ink);
      text-align: left;
    }
    @media (hover: hover) and (pointer: fine) {
      .tie-btn:hover { border-color: var(--gold, #E8C547); background: var(--gold-light, #FCF3D0); }
    }
    .tie-btn strong { display: block; color: var(--navy); font-size: 19px; margin-bottom: 5px; }
    .tie-btn span { color: var(--muted); line-height: 1.5; }

    .result-card {
      padding: clamp(24px, 4vw, 46px);
      position: relative;
      --acc: var(--green);
      --acc-soft: var(--green-light);
      --acc-dark: var(--navy);
      border-radius: 28px;
      border: 1.5px solid color-mix(in srgb, var(--acc) 30%, var(--line));
      background: linear-gradient(180deg, color-mix(in srgb, var(--acc-soft) 55%, white), white 320px);
    }

    .result-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 6px;
      padding-bottom: 25px;
      border-bottom: 1px solid color-mix(in srgb, var(--acc) 18%, var(--line));
    }

    .result-icon {
      width: clamp(150px, 28vw, 220px);
      height: clamp(150px, 28vw, 220px);
      border-radius: 50%;
      display: grid;
      place-items: center;
      font-size: clamp(84px, 16vw, 130px);
      background: var(--acc-soft);
      box-shadow: 0 14px 30px -8px color-mix(in srgb, var(--acc) 45%, transparent), inset 0 0 0 5px white;
      margin-bottom: 10px;
    }
    .result-icon img {
      width: 92%;
      height: 92%;
      border-radius: 50%;
      object-fit: cover;
    }
    .start-preview {
      margin: 6px 0 18px;
      text-align: center;
    }
    .start-preview-icons {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      max-width: 828px;
      margin: 0 auto 12px;
    }
    @media (max-width: 480px) {
      .start-preview-icons {
        grid-template-columns: repeat(2, 1fr);
        max-width: 504px;
        gap: 14px;
        margin-left: -26px;
        margin-right: -26px;
      }
    }
    .start-preview-icon {
      width: 100%;
      aspect-ratio: 1 / 1;
      border-radius: 50%;
      background: #fff;
      display: grid;
      place-items: center;
      box-shadow: 0 10px 22px -6px rgba(20, 30, 60, 0.28), inset 0 0 0 4px #f2f4f8;
    }
    .start-preview-icon img {
      width: 90%;
      height: 90%;
      border-radius: 50%;
      object-fit: cover;
    }
    .start-preview-caption {
      font-size: 14px;
      font-weight: 700;
      color: var(--navy-2, #33415c);
      margin: 0;
    }
    @media (prefers-reduced-motion: reduce) {
      .result-icon { animation: none; }
    }

    .result-kicker {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      max-width: 100%;
      color: var(--acc-dark);
      background: color-mix(in srgb, var(--acc-soft) 70%, white);
      font-weight: 900;
      font-size: 13px;
      padding: 7px 16px;
      border-radius: 999px;
      margin-bottom: 12px;
      white-space: nowrap;
    }

    .result-title {
      color: var(--acc-dark);
      font-size: clamp(22px, 3.6vw, 30px);
      line-height: 1.18;
      letter-spacing: -0.03em;
      margin-bottom: 10px;
      font-weight: 900;
      white-space: nowrap;
      max-width: 100%;
    }

    .result-desc {
      color: var(--muted);
      line-height: 1.6;
      font-size: 14px;
      margin-bottom: 0;
      word-break: keep-all;
      max-width: 520px;
    }

    .result-card .panel {
      border-radius: 24px;
      padding: 22px;
      margin-top: 22px;
      border: 1px solid color-mix(in srgb, var(--acc) 22%, var(--line));
      background: color-mix(in srgb, var(--acc-soft) 45%, #FBFDFD);
    }
    .result-card .panel h3 {
      color: var(--acc-dark);
      font-size: 18px;
      margin-bottom: 14px;
    }

    .activity-mini {
      margin-top: 16px;
    }
    .activity-mini h4 {
      color: var(--muted);
      font-size: 13px;
      font-weight: 800;
      margin: 0 0 10px;
    }
    .activity-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .activity-list li {
      display: flex;
      gap: 5px;
      align-items: center;
      background: color-mix(in srgb, var(--acc-soft, #EAF7F0) 55%, white);
      color: var(--acc-dark, #1E8A54);
      font-weight: 700;
      font-size: 12px;
      line-height: 1.3;
      padding: 6px 12px;
      border-radius: 999px;
    }
    .activity-list li::before {
      content: "✓";
      color: var(--acc, #26A269);
      font-weight: 1000;
    }

    .action-panel {
      background: var(--acc-soft, var(--green-light));
      color: var(--acc-dark, var(--navy));
      border: 0;
    }
    .action-panel h3 { color: var(--acc-dark, var(--navy)); opacity: .85; }
    .action-panel p {
      margin: 0;
      color: #1A1A1A;
      font-size: 21px;
      line-height: 1.5;
      font-weight: 900;
      word-break: keep-all;
    }

    .result-actions {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 12px;
      margin-top: 20px;
    }
    .result-card .result-actions .secondary-btn {
      border-radius: 999px;
    }
    .result-card .result-actions .secondary-btn.yellow {
      background: var(--acc, #FFF3D6);
      color: white;
    }
    .result-card .result-actions .secondary-btn.dark {
      background: var(--acc-dark, var(--navy));
    }
    .secondary-btn.yellow { background: #FFF3D6; color: #8A5A00; }

    .secondary-btn {
      min-height: 58px;
      border-radius: 16px;
      padding: 12px 16px;
      font-weight: 900;
      font-size: 16px;
      background: var(--blue-light);
      color: var(--navy);
      border: 1px solid rgba(20,61,91,.10);
    }
    @media (hover: hover) and (pointer: fine) {
      .secondary-btn:hover { background: #DDECF3; }
    }
    .secondary-btn.green { background: var(--green-light); color: #167346; }
    .secondary-btn.dark { background: var(--navy); color: white; }

    .email-panel {
      margin-top: 22px;
      padding: 22px;
      border-radius: 24px;
      background: color-mix(in srgb, var(--acc-soft, #F6FAFB) 55%, white);
      border: 1.5px solid color-mix(in srgb, var(--acc) 22%, var(--line));
    }
    .email-title {
      color: var(--acc-dark, var(--navy));
      font-size: 16px;
      font-weight: 900;
      text-align: center;
      margin: 0 0 16px;
    }
    .email-panel .email-sub {
      color: var(--acc-dark, var(--muted));
      font-weight: 700;
      font-size: 13px;
      line-height: 1.5;
      margin: 14px 0 16px;
      text-align: center;
    }
    .email-input::placeholder {
      color: #A7B0B5;
    }
    .email-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    .email-row.name-row {
      margin-bottom: 10px;
    }
    .email-input {
      flex: 1 1 220px;
      min-height: 52px;
      border-radius: 999px;
      border: 2px solid color-mix(in srgb, var(--acc) 25%, var(--line));
      padding: 0 20px;
      font-size: 16px;
      color: var(--ink);
      background: white;
    }
    .email-input:focus {
      outline: none;
      border-color: var(--acc, var(--green));
    }
    #comment-send-btn {
      flex: 0 0 auto;
      min-height: 52px;
      padding: 0 22px;
      border-radius: 999px;
      background: var(--acc-dark, var(--green));
      color: white;
      font-weight: 900;
      font-size: 15px;
    }
    #comment-send-btn:disabled {
      background: #BFD8CC;
      cursor: not-allowed;
    }
    .email-domain-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: -6px 0 14px;
    }
    .email-domain-chip {
      padding: 7px 14px;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: #fff;
      color: var(--muted);
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }
    .email-domain-chip:active {
      background: var(--lemon, #F8F8CE);
      color: var(--lemon-ink, #8C8C3A);
      border-color: var(--lemon-line, #EDE7A8);
    }
    @media (hover: hover) and (pointer: fine) {
      .email-domain-chip:hover {
        background: var(--lemon, #F8F8CE);
        color: var(--lemon-ink, #8C8C3A);
        border-color: var(--lemon-line, #EDE7A8);
      }
    }
    .consent-row {
      display: flex;
