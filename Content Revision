    /* ==============================
       결과 이미지 저장 (SNS 공유용 카드, 1080x1350)
       ============================== */
    function wrapCanvasLines(ctx, text, maxWidth) {
      const lines = [];
      String(text).split("\n").forEach(paragraph => {
        let line = "";
        for (const ch of paragraph) {
          const test = line + ch;
          if (ctx.measureText(test).width > maxWidth && line !== "") {
            lines.push(line);
            line = ch;
          } else {
            line = test;
          }
        }
        lines.push(line);
      });
      return lines;
    }

    function loadLogoImage() {
      return new Promise(resolve => {
        const src = document.querySelector(".brand-logo") && document.querySelector(".brand-logo").src;
        if (!src) { resolve(null); return; }
        const img = new Image();
        img.onload = () => resolve(img);
        img.onerror = () => resolve(null);
        img.src = src;
      });
    }

    // 기기마다 다르게 보이는 이모지 대신, 모든 기기에서 동일하게 보이도록
    // 고정된 캐릭터 이미지(base64)를 로드합니다.
    function loadIconImage(src) {
      return new Promise(resolve => {
        if (!src) { resolve(null); return; }
        const img = new Image();
        img.onload = () => resolve(img);
        img.onerror = () => resolve(null);
        img.src = src;
      });
    }

    // 구형 브라우저(구버전 Safari 등)는 ctx.roundRect를 지원하지 않아
    // 결과 이미지 생성이 조용히 실패할 수 있어 폴리필을 추가합니다.
    if (typeof CanvasRenderingContext2D !== "undefined" && !CanvasRenderingContext2D.prototype.roundRect) {
      CanvasRenderingContext2D.prototype.roundRect = function (x, y, w, h, r) {
        if (typeof r === "number") r = { tl: r, tr: r, br: r, bl: r };
        this.beginPath();
        this.moveTo(x + r.tl, y);
        this.lineTo(x + w - r.tr, y);
        this.arcTo(x + w, y, x + w, y + r.tr, r.tr);
        this.lineTo(x + w, y + h - r.br);
        this.arcTo(x + w, y + h, x + w - r.br, y + h, r.br);
        this.lineTo(x + r.bl, y + h);
        this.arcTo(x, y + h, x, y + h - r.bl, r.bl);
        this.lineTo(x, y + r.tl);
        this.arcTo(x, y, x + r.tl, y, r.tl);
        this.closePath();
        return this;
      };
    }

    async function buildResultCanvas(t, name) {
        const W = 1080;
        const FONT = '"Apple SD Gothic Neo", "Noto Sans KR", "Malgun Gothic", sans-serif';
        const cx0 = W / 2;
        const bgColor = t.bg || "#F6FAFB";
        const accent = t.accent || "#26A269";
        const accentDark = t.accentDark || "#143D5B";

        // 먼저 임시 캔버스로 콘텐츠 높이를 측정해서, 최종 캔버스 높이(H)를
        // 콘텐츠에 맞게 정해준다. (내용이 길어져도 하단 브랜드 문구가
        // "오늘의 임팩트 액션" 박스에 가려지지 않도록)
        const measureCanvas = document.createElement("canvas");
        const mctx = measureCanvas.getContext("2d");

        const panelX = 96, panelW = W - 192;
        const panelPadY = 40;
        mctx.font = `600 27px ${FONT}`;
        const descLines0 = wrapCanvasLines(mctx, t.desc, panelW - 80);
        const chipFont = `700 24px ${FONT}`;
        mctx.font = chipFont;
        const chipPadX = 22, chipH = 48, chipGap = 12, chipRowGap = 12;
        const chipRows0 = [];
        {
          let rowItems = [], rowWidth = 0;
          t.activities.slice(0, 4).forEach(item => {
            const label = "✓ " + item;
            const w = mctx.measureText(label).width + chipPadX * 2;
            if (rowWidth + w + (rowItems.length ? chipGap : 0) > panelW - 80 && rowItems.length) {
              chipRows0.push({ items: rowItems, width: rowWidth });
              rowItems = []; rowWidth = 0;
            }
            if (rowItems.length) rowWidth += chipGap;
            rowWidth += w;
            rowItems.push({ label, w });
          });
          if (rowItems.length) chipRows0.push({ items: rowItems, width: rowWidth });
        }
        const panelH0 = panelPadY + descLines0.length * 38 + 34 + chipRows0.length * (chipH + chipRowGap) + panelPadY;

        const charCY0 = 400, charR0 = 190;
        let yAfterPanel = charCY0 + charR0 + 90; // 제목 시작 y
        yAfterPanel += (name || "").trim() ? 46 : 0; // 이름 배지
        yAfterPanel += 50; // 태그라인
        yAfterPanel += 56; // 패널 시작 전 여백
        const panelY0 = yAfterPanel;
        const actionBoxY0 = panelY0 + panelH0 + 44;
        const actionBoxBottom0 = actionBoxY0 + 150;
        const footerY0 = actionBoxBottom0 + 74;
        const H = Math.max(1350, footerY0 + 70);

        const canvas = document.createElement("canvas");
        canvas.width = W;
        canvas.height = H;
        const ctx = canvas.getContext("2d");

        function drawSparkle(cx, cy, r, color, alpha) {
          ctx.save();
          ctx.globalAlpha = alpha;
          ctx.fillStyle = color;
          ctx.beginPath();
          ctx.moveTo(cx, cy - r);
          ctx.quadraticCurveTo(cx + r * 0.18, cy - r * 0.18, cx + r, cy);
          ctx.quadraticCurveTo(cx + r * 0.18, cy + r * 0.18, cx, cy + r);
          ctx.quadraticCurveTo(cx - r * 0.18, cy + r * 0.18, cx - r, cy);
          ctx.quadraticCurveTo(cx - r * 0.18, cy - r * 0.18, cx, cy - r);
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        }

        // 배경: 유형별 파스텔 단색
        ctx.fillStyle = bgColor;
        ctx.fillRect(0, 0, W, H);

        // 점선 테두리 프레임
        ctx.save();
        ctx.strokeStyle = accent;
        ctx.globalAlpha = 0.45;
        ctx.lineWidth = 3;
        ctx.setLineDash([2, 14]);
        ctx.lineCap = "round";
        ctx.beginPath();
        ctx.roundRect(40, 40, W - 80, H - 80, 40);
        ctx.stroke();
        ctx.restore();

        // 캐릭터 주변 반짝이 장식
        drawSparkle(cx0 + 230, 190, 22, accent, 0.85);
        drawSparkle(cx0 - 250, 150, 14, accent, 0.6);
        drawSparkle(cx0 + 300, 320, 10, "#FFFFFF", 0.9);
        drawSparkle(cx0 - 300, 340, 12, "#FFFFFF", 0.7);

        // 로고 (작게, 좌상단)
        const logo = await loadLogoImage();
        if (logo) {
          const logoW = 176;
          const logoH = logoW * (logo.height / logo.width);
          ctx.drawImage(logo, 76, 72, logoW, logoH);
        }

        // 캐릭터 이미지 (기기별 이모지 차이 없이 고정된 그림으로 표시)
        const iconImg = await loadIconImage(t.iconImg);

        // 상단 라벨
        ctx.textAlign = "center";
        ctx.fillStyle = accentDark;
        ctx.globalAlpha = 0.75;
        ctx.font = `800 26px ${FONT}`;
        ctx.fillText("나의 임팩트 유형은...", cx0, 178);
        ctx.globalAlpha = 1;

        // 캐릭터(동물 아이콘) 뒤 큰 원형 배지
        const charCY = 400, charR = 190;
        ctx.save();
        ctx.shadowColor = "rgba(0,0,0,0.10)";
        ctx.shadowBlur = 40;
        ctx.shadowOffsetY = 18;
        ctx.fillStyle = "#FFFFFF";
        ctx.beginPath();
        ctx.arc(cx0, charCY, charR, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();

        if (iconImg) {
          const iconR = charR * 0.86;
          ctx.save();
          ctx.beginPath();
          ctx.arc(cx0, charCY, iconR, 0, Math.PI * 2);
          ctx.clip();
          ctx.drawImage(iconImg, cx0 - iconR, charCY - iconR, iconR * 2, iconR * 2);
          ctx.restore();
        } else {
          ctx.font = `280px ${FONT}`;
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.fillText(t.icon, cx0, charCY + 14);
          ctx.textBaseline = "alphabetic";
        }

        let y = charCY + charR + 90;

        // 제목
        ctx.fillStyle = accentDark;
        ctx.font = `900 58px ${FONT}`;
        ctx.fillText(t.name, cx0, y);

        // 이름 배지 (선택 입력)
        const trimmedName = (name || "").trim();
        if (trimmedName) {
          y += 46;
          ctx.font = `800 25px ${FONT}`;
          ctx.fillStyle = accent;
          ctx.fillText(`${trimmedName.slice(0, 12)}님의 결과예요`, cx0, y);
        }

        // 태그라인
        y += 50;
        ctx.font = `800 27px ${FONT}`;
        ctx.fillStyle = accent;
        ctx.fillText(t.tagline || t.label, cx0, y);

        y += 56;

        // 흰색 콘텐츠 패널 (높이는 미리 측정해둔 값을 그대로 사용)
        const descLines = descLines0;
        const chipRows = chipRows0;
        const panelH = panelH0;
        ctx.save();
        ctx.shadowColor = "rgba(0,0,0,0.08)";
        ctx.shadowBlur = 30;
        ctx.shadowOffsetY = 14;
        ctx.fillStyle = "#FFFFFF";
        ctx.beginPath();
        ctx.roundRect(panelX, y, panelW, panelH, 32);
        ctx.fill();
        ctx.restore();

        let py = y + panelPadY;
        ctx.textAlign = "left";
        ctx.fillStyle = "#4B5B63";
        ctx.font = `600 27px ${FONT}`;
        descLines.forEach(line => { py += 30; ctx.fillText(line, panelX + 40, py); });
        py += 8;

        py += 34;
        let cx2 = panelX + 40, cy2 = py;
        let curRowW = chipRows[0] ? chipRows[0].width : 0;
        let curStartX = panelX + 40;
        chipRows.forEach((row, ri) => {
          cx2 = panelX + 40;
          ctx.font = chipFont;
          row.items.forEach(({ label, w }) => {
            ctx.fillStyle = bgColor;
            ctx.beginPath();
            ctx.roundRect(cx2, cy2, w, chipH, chipH / 2);
            ctx.fill();
            ctx.fillStyle = accentDark;
            ctx.textBaseline = "middle";
            ctx.fillText(label, cx2 + chipPadX, cy2 + chipH / 2 + 1);
            ctx.textBaseline = "alphabetic";
            cx2 += w + chipGap;
          });
          cy2 += chipH + chipRowGap;
        });

        y = y + panelH + 44;

        // 오늘의 임팩트 액션
        ctx.save();
        ctx.shadowColor = "rgba(0,0,0,0.10)";
        ctx.shadowBlur = 24;
        ctx.shadowOffsetY = 10;
        ctx.fillStyle = accentDark;
        ctx.beginPath();
        ctx.roundRect(panelX, y, panelW, 150, 28);
        ctx.fill();
        ctx.restore();

        ctx.textAlign = "left";
        ctx.fillStyle = "rgba(255,255,255,0.75)";
        ctx.font = `900 23px ${FONT}`;
        ctx.fillText("🎯 오늘의 임팩트 액션", panelX + 32, y + 42);

        ctx.fillStyle = "#FFFFFF";
        ctx.font = `800 25px ${FONT}`;
        const actionLines = wrapCanvasLines(ctx, t.action, panelW - 64);
        let ay = y + 78;
        actionLines.slice(0, 3).forEach(line => {
          ctx.fillText(line, panelX + 32, ay);
          ay += 33;
        });

        // 하단 브랜드 문구 (액션 박스 아래, 항상 겹치지 않는 위치에 동적으로 배치)
        const footerY = y + 150 + 74;
        ctx.textAlign = "center";
        ctx.fillStyle = accentDark;
        ctx.globalAlpha = 0.7;
        ctx.font = `800 22px ${FONT}`;
        ctx.fillText(`#${t.label}  ·  15문항 임팩트 유형 테스트  ·  함께일하는재단 💚`, cx0, footerY);
        ctx.globalAlpha = 1;
        ctx.textAlign = "left";

      return canvas;
    }

    async function getResultImageBase64(t, name) {
      const canvas = await buildResultCanvas(t, name);
      const dataUrl = canvas.toDataURL("image/png");
      return dataUrl.split(",")[1] || "";
    }

    bindTap(document.getElementById("start-btn"), goToInfoScreen);
    bindTap(document.getElementById("info-next-btn"), startTest);
    bindTap(document.getElementById("back-btn"), goBack);
    bindTap(document.getElementById("restart-btn"), restart);
    bindTap(document.getElementById("cases-btn"), openCases);
    bindTap(document.getElementById("send-email-btn"), sendResultEmail);
    bindTap(document.getElementById("comment-send-btn"), submitComment);
    bindTap(document.getElementById("info-consent-toggle-btn"), () => {
      document.getElementById("info-consent-details").classList.toggle("open");
    });
    document.getElementById("info-name-input").addEventListener("input", updateInfoButtonState);
    document.getElementById("info-phone-input").addEventListener("input", (e) => {
      const cursorAtEnd = e.target.selectionEnd === e.target.value.length;
      e.target.value = formatPhoneNumber(e.target.value);
      if (cursorAtEnd) {
        e.target.setSelectionRange(e.target.value.length, e.target.value.length);
      }
      updateInfoButtonState();
    });
    document.getElementById("info-phone-input").addEventListener("focus", (e) => {
      const val = e.target.value;
      if (val === "010-") {
        e.target.setSelectionRange(val.length, val.length);
      }
    });
    document.getElementById("info-email-input").addEventListener("input", updateInfoButtonState);
    document.getElementById("info-consent-checkbox").addEventListener("change", updateInfoButtonState);
    document.querySelectorAll(".email-domain-chip").forEach((chip) => {
      bindTap(chip, () => {
        const emailInput = document.getElementById("info-email-input");
        const domain = chip.dataset.domain;
        const current = emailInput.value.trim();
        const local = current.includes("@") ? current.split("@")[0] : current;
        emailInput.value = local ? `${local}@${domain}` : "";
        emailInput.focus();
        updateInfoButtonState();
      });
    });
    bindTap(document.getElementById("more-btn"), () => openModal("more-modal"));
    bindTap(document.getElementById("stats-btn"), openStats);
    bindTap(document.getElementById("fullscreen-btn"), toggleFullscreen);
    bindTap(document.getElementById("reset-stats-btn"), resetStats);
    bindTap(document.getElementById("download-csv-btn"), downloadCSV);
    bindTap(document.getElementById("open-site-btn"), () => {
      try {
        window.location.href = CONFIG.infoUrl;
      } catch (_) {
        window.open(CONFIG.infoUrl, "_blank", "noopener");
      }
    });

    document.querySelectorAll("[data-close]").forEach(btn => {
      bindTap(btn, () => closeModal(btn.dataset.close));
    });

    document.querySelectorAll(".modal").forEach(modal => {
      bindTap(modal, event => {
        if (event.target === modal) closeModal(modal.id);
      });
    });

    document.addEventListener("keydown", event => {
      if (event.key === "Escape") {
        document.querySelectorAll(".modal.open").forEach(modal => closeModal(modal.id));
      }
    });
  </script>

</body></html>
