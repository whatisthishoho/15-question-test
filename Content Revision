    function calculateResult() {
      const scores = { problem: 0, idea: 0, execute: 0, connect: 0 };
      const opportunities = { problem: 0, idea: 0, execute: 0, connect: 0 };

      QUESTIONS.forEach(question => {
        question.answers.forEach(answer => {
          if (opportunities.hasOwnProperty(answer.type)) {
            opportunities[answer.type] += 1;
          }
        });
      });

      answers.forEach(type => {
        if (scores.hasOwnProperty(type)) scores[type] += 1;
      });

      // 유형별 선택지 등장 횟수 차이를 줄이기 위해 선택 비율로 보정
      const normalized = {};
      Object.keys(scores).forEach(key => {
        normalized[key] = opportunities[key] > 0
          ? scores[key] / opportunities[key]
          : 0;
      });

      const max = Math.max(...Object.values(normalized));
      const epsilon = 0.000001;
      const winners = Object.keys(normalized).filter(
        key => Math.abs(normalized[key] - max) < epsilon
      );

      if (winners.length === 1) {
        showResult(winners[0]);
      } else {
        showTieBreaker(winners);
      }
    }

